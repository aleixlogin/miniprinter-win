<loc:ThemedWindow x:Class="MiniPrinter.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MiniPrinter.Tray"
        Title="MiniPrinter" Icon="pack://application:,,,/miniprinter.ico" Width="720" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDropFiles" DragOver="OnDragOver">
    <DockPanel Margin="12">
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="{DynamicResource Brush.WarnBackground}" BorderBrush="{DynamicResource Brush.WarnBorder}" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="Tabs">
            <!-- Estado -->
            <TabItem Header="{loc:T Main.Estado}" x:Name="StatusTab">
                <Grid x:Name="StatusRoot" Margin="10">
                    <Grid.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
                        <loc:NotNullConverter x:Key="NotNull" />
                        <!-- The card takes the colours of the severity of the state. -->
                        <Style x:Key="StatusCard" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Ok">
                                    <Setter Property="Background" Value="{DynamicResource Brush.OkBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OkBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Info">
                                    <Setter Property="Background" Value="{DynamicResource Brush.InfoBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.InfoBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Warn">
                                    <Setter Property="Background" Value="{DynamicResource Brush.WarnBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource Brush.ErrorBackground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="StatusGlyph" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                            <Setter Property="FontSize" Value="34" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="4,0,16,0" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Summary.Severity}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Brush.Error}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="JobGlyph" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            <Setter Property="Text" Value="…" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="Done"><Setter Property="Text" Value="✔" /><Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Printing"><Setter Property="Text" Value="●" /><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Held"><Setter Property="Text" Value="⚠" /><Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Failed"><Setter Property="Text" Value="✖" /><Setter Property="Foreground" Value="{DynamicResource Brush.Error}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Canceled"><Setter Property="Text" Value="⊘" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tarjeta de estado -->
                    <Border Grid.Row="0" Style="{StaticResource StatusCard}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource StatusGlyph}" Text="{Binding Summary.Glyph}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Summary.Title}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary.Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ShowsBattery, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="{loc:T Main.Bateria}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ProgressBar Width="150" Minimum="0" Maximum="100" Value="{Binding BatteryPercent, Mode=OneWay}"
                                                 Visibility="{Binding ShowsBatteryBar, Converter={StaticResource BoolToVisible}}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BatteryIsLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding BatteryText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Padding="12,5" Content="{Binding Summary.ActionText}" Command="{Binding SummaryAction}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Summary.Action}" Value="None">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Padding="12,5" Margin="0,6,0,0" Content="{loc:T Diag.Open}" Command="{Binding Diagnose}"
                                        Visibility="{Binding ShowsDiagnose, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Acciones: solo Conectar y Página de prueba; el resto en «⋯» -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{Binding ConnectText}" Command="{Binding ConnectOrDisconnect}" />
                        <Button Content="{loc:T Main.PaginaDePrueba}" Command="{Binding TestPrint}" />
                        <Button x:Name="MoreButton" Content="⋯" Click="OnMoreActions" ToolTip="{loc:T Status.More}" Padding="12,3" MinWidth="44" FontWeight="Bold">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{loc:T Main.AvanzarPapel}" Command="{Binding Feed}" />
                                    <MenuItem Header="{Binding SamplingText}" Command="{Binding ToggleSampling}" />
                                    <MenuItem Header="{loc:T Main.ExportarRegistroDeBateria}" Click="OnExportTelemetry" />
                                    <Separator />
                                    <MenuItem Header="{loc:T Main.VistaPreviaDelUltimoTrabajo}" Click="OnPreviewLast" />
                                    <MenuItem Header="{loc:T Diag.Open}" Command="{Binding Diagnose}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="{Binding SamplingInfo}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>

                    <!-- Detalles plegables -->
                    <Expander Grid.Row="2" Header="{loc:T Status.Details}" Margin="0,10,0,0" IsExpanded="{Binding DetailsOpen, Mode=TwoWay}">
                        <Grid Margin="4,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Grid.Row="0" Text="{loc:T Main.Impresora}" />
                            <TextBlock Style="{StaticResource Value}" Grid.Row="0" Grid.Column="1" Text="{Binding PrinterText}" />
                            <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="{loc:T Main.Conexion}" />
                            <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="1" Text="{Binding LinkText}" />
                            <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="{loc:T Main.Firmware}" />
                            <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="1" Text="{Binding FirmwareText}" />
                            <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="{loc:T Main.ImprimirDesde}" />
                            <TextBlock Style="{StaticResource Value}" Grid.Row="3" Grid.Column="1" Text="{Binding UrlsText}" />
                            <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="{loc:T Main.Servicio}" />
                            <TextBlock Style="{StaticResource Value}" Grid.Row="4" Grid.Column="1" Text="{Binding ServiceText}" />
                        </Grid>
                    </Expander>

                    <TextBlock Grid.Row="3" Text="{loc:T Main.Trabajos}" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <ListView Grid.Row="4" x:Name="JobsList" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                              MouseDoubleClick="OnJobDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource JobGlyph}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Id}" />
                                <GridViewColumn Header="{loc:T Main.Documento}" Width="150" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{loc:T Main.Estado}" Width="100" DisplayMemberBinding="{Binding StateText}" />
                                <GridViewColumn Header="{loc:T Main.Detalle}" Width="190" DisplayMemberBinding="{Binding MessageText}" />
                                <GridViewColumn Header="{loc:T Status.Origin}" Width="170" DisplayMemberBinding="{Binding OriginText}" />
                                <GridViewColumn Header="{loc:T Main.Hora}" Width="70" DisplayMemberBinding="{Binding Created, StringFormat=HH:mm:ss}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:T Status.Preview}" Click="OnPreviewSelectedJob" IsEnabled="{Binding SelectedJob, Converter={StaticResource NotNull}}" />
                        <Button Content="{loc:T Status.Reprint}" Command="{Binding ReprintJob}" Visibility="{Binding SelectedJob.CanReprint, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}" />
                        <Button Content="{loc:T Main.CancelarTrabajo}" Command="{Binding CancelJob}" Visibility="{Binding SelectedJob.CanCancel, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Buscar -->
            <TabItem Header="{loc:T Main.BuscarImpresoras}" x:Name="SearchTab">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="{loc:T Main.EnciendeLaImpresoraPulsacionLarga}" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="ScanButton" Content="{loc:T Main.Buscar}" Click="OnScan" />
                        <CheckBox x:Name="OnlyPrinters" Content="{loc:T Main.SoloImpresorasReconocidas}" IsChecked="True" VerticalAlignment="Center"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                        <TextBlock x:Name="ScanStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:T Main.Emparejar}" Click="OnPair" />
                        <Button Content="{loc:T Main.UsarEstaImpresora}" Click="OnUsePrinter" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:T Main.Conexion2}" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <ComboBox x:Name="TransportCombo" Width="190" SelectedIndex="0">
                            <ComboBoxItem Content="{loc:T Main.BluetoothRfcommRecomendado}" Tag="Rfcomm" />
                            <ComboBoxItem Content="{loc:T Main.PuertoCom}" Tag="Serial" />
                            <ComboBoxItem Content="{loc:T Main.SimuladaPruebas}" Tag="Simulated" />
                        </ComboBox>
                    </StackPanel>
                    <ListView x:Name="DevicesList" MouseDoubleClick="OnUsePrinter">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:T Main.Nombre}" Width="170" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="{loc:T Main.Direccion}" Width="140" DisplayMemberBinding="{Binding Address}" />
                                <GridViewColumn Header="{loc:T Main.Modelo}" Width="190" DisplayMemberBinding="{Binding Model}" />
                                <GridViewColumn Header="{loc:T Main.Emparejada}" Width="85" DisplayMemberBinding="{Binding PairedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- Plantillas -->
            <TabItem Header="{loc:T Main.Plantillas}" x:Name="TemplatesTab">
                <DockPanel Margin="10" x:Name="TemplatesRoot">
                    <DockPanel.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
                        <loc:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisible" />
                        <loc:BytesToImageConverter x:Key="BytesToImage" />
                    </DockPanel.Resources>

                    <!-- Galería: buscador, interruptor galería/lista y tarjetas con miniatura -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <!-- Two buttons rather than radio buttons: the one of the view in use is the one in bold. -->
                            <Button Content="{loc:T Templates.ViewGallery}" Command="{Binding ShowGallery}" Padding="10,3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGallery}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:T Templates.ViewList}" Command="{Binding ShowList}" Padding="10,3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsList}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="TemplateSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:T Templates.Search}" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TemplateSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding IsGallery, Converter={StaticResource BoolToVisible}}">
                        <ListBox x:Name="TemplateGallery" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" Height="196"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="150" Margin="3" ToolTip="{Binding Description}">
                                        <Border Height="104" BorderBrush="{DynamicResource Brush.PreviewBorder}" BorderThickness="1" Background="{DynamicResource Brush.Preview}">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToImage}}" Stretch="Uniform" Margin="4"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Marker}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="6" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:T Templates.NoMatches}" Margin="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisible}}" />
                    </Grid>

                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T Main.Plantilla}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding IsGallery, Converter={StaticResource InvertedBoolToVisible}}" />
                        <ComboBox x:Name="TemplateCombo" Width="200" Visibility="{Binding IsGallery, Converter={StaticResource InvertedBoolToVisible}}" />
                        <Button Content="↻" Click="OnTemplateReload" ToolTip="{loc:T Main.ActualizarLaListaDePlantillas}" />
                        <Button x:Name="TemplateCreate" Content="{loc:T Main.Crear}" ToolTip="{loc:T Main.CrearUnaPlantillaNuevaEn}" />
                        <Button x:Name="TemplateEdit" Content="{loc:T Main.Editar}" ToolTip="{loc:T Main.AbrirLaPlantillaEnEl}" />
                        <Button x:Name="TemplateDelete" Content="{loc:T Main.Eliminar}" />
                        <TextBlock Text="{loc:T Main.Favoritos}" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox x:Name="FavoriteCombo" Width="150" IsEditable="True" ToolTip="{loc:T Main.EligeUnFavoritoOEscribe}" />
                        <Button Content="{loc:T Main.Guardar}" Click="OnFavoriteSave" />
                        <Button Content="{loc:T Main.Borrar}" Click="OnFavoriteDelete" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{loc:T Main.Copias}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="TemplateCopies" Text="1" Width="40" VerticalContentAlignment="Center" />
                        <Button Content="{loc:T Main.CargarCsv}" Click="OnTemplateCsv" ToolTip="{loc:T Main.UnaEtiquetaPorFilaLa}" />
                        <Button x:Name="TemplateCsvClear" Content="{loc:T Main.QuitarCsv}" Click="OnTemplateCsvClear" Visibility="Collapsed" />
                        <Button Content="{loc:T Main.Imprimir}" Click="OnTemplatePrint" FontWeight="SemiBold" />
                        <TextBlock x:Name="TemplateStatus" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                            <StackPanel x:Name="TemplateForm" />
                        </ScrollViewer>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.PreviewBorder}" BorderThickness="1" Background="{DynamicResource Brush.Preview}" Width="410">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Image x:Name="TemplatePreview" Stretch="None" Margin="12" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Ajustes -->
            <TabItem Header="{loc:T Main.Ajustes}" x:Name="SettingsTab">
                <Grid x:Name="SettingsRoot">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="Settings/SettingsViews.xaml" />
                            </ResourceDictionary.MergedDictionaries>
                            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
                        </ResourceDictionary>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="170" MaxWidth="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Menú lateral con búsqueda -->
                    <DockPanel Margin="8,10,8,8">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBox x:Name="SettingsSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:T Settings.Search}" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SettingsSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ListBox x:Name="SectionList" ItemsSource="{Binding VisibleSections}" SelectedItem="{Binding Selected}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,5">
                                        <TextBlock DockPanel.Dock="Right" Text="●" Margin="10,0,0,0" Foreground="{DynamicResource Brush.Accent}"
                                                   ToolTip="{loc:T Settings.UnsavedMarker}"
                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisible}}" />
                                        <TextBlock Text="{Binding Title}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Sección elegida -->
                    <DockPanel Grid.Column="1" Margin="0,8,8,8">
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,1,0,0" Padding="10,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.IsDirty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{loc:T Settings.Discard}" Command="{Binding Discard}" Margin="0,0,8,0" />
                                    <Button Content="{loc:T Settings.Apply}" Command="{Binding Apply}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{loc:T Settings.Unsaved}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="10,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid Grid.IsSharedSizeScope="True" Margin="6,2,10,10">
                                <ContentControl Content="{Binding Selected}" Focusable="False" />
                                <TextBlock Text="{loc:T Settings.NoMatches}" Foreground="{DynamicResource Brush.TextMuted}" Margin="6,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VisibleSections.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</loc:ThemedWindow>
