<Window x:Class="MiniPrinter.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniPrinter" Icon="pack://application:,,,/miniprinter.ico" Width="720" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterScreen" FontSize="13" AllowDrop="True" Drop="OnDropFiles" DragOver="OnDragOver">
    <DockPanel Margin="12">
        <Border x:Name="Banner" DockPanel.Dock="Top" Background="#FFF8C5" BorderBrush="#D4A72C" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock x:Name="BannerText" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="Tabs">
            <!-- Estado -->
            <TabItem Header="Estado">
                <DockPanel Margin="10">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Grid.Row="0" Text="Impresora" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="0" Grid.Column="1" x:Name="PrinterText" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Conexión" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="1" Grid.Column="1" x:Name="LinkText" />
                        <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Estado" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="2" Grid.Column="1" x:Name="StateText" />
                        <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Batería" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="3" Grid.Column="1" x:Name="BatteryText" />
                        <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="Firmware" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="4" Grid.Column="1" x:Name="FirmwareText" />
                        <TextBlock Style="{StaticResource Label}" Grid.Row="5" Text="Imprimir desde" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="5" Grid.Column="1" x:Name="UrlsText" />
                        <TextBlock Style="{StaticResource Label}" Grid.Row="6" Text="Servicio" />
                        <TextBlock Style="{StaticResource Value}" Grid.Row="6" Grid.Column="1" x:Name="ServiceText" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12">
                        <Button x:Name="ConnectButton" Content="Conectar" Click="OnConnect" />
                        <Button Content="Página de prueba" Click="OnTestPrint" />
                        <Button Content="Avanzar papel" Click="OnFeed" />
                        <Button Content="Vista previa del último trabajo" Click="OnPreview" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="SamplingButton" Content="Muestrear batería 8 h" Click="OnSampling" />
                        <Button Content="Exportar registro de batería" Click="OnExportTelemetry" />
                        <TextBlock x:Name="SamplingText" VerticalAlignment="Center" Foreground="#57606A" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Trabajos" FontWeight="SemiBold" Margin="0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Cancelar trabajo" Click="OnCancelJob" />
                        <ListView x:Name="JobsList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Id}" />
                                    <GridViewColumn Header="Documento" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Estado" Width="110" DisplayMemberBinding="{Binding State}" />
                                    <GridViewColumn Header="Detalle" Width="200" DisplayMemberBinding="{Binding Message}" />
                                    <GridViewColumn Header="Hora" Width="70" DisplayMemberBinding="{Binding Created, StringFormat=HH:mm:ss}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <!-- Buscar -->
            <TabItem Header="Buscar impresoras" x:Name="SearchTab">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Enciende la impresora (pulsación larga). Se listan los dispositivos Bluetooth emparejados y cercanos; las impresoras reconocidas aparecen arriba." />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="ScanButton" Content="Buscar" Click="OnScan" />
                        <CheckBox x:Name="OnlyPrinters" Content="Solo impresoras reconocidas" IsChecked="True" VerticalAlignment="Center"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                        <TextBlock x:Name="ScanStatus" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#57606A" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Emparejar" Click="OnPair" />
                        <Button Content="Usar esta impresora" Click="OnUsePrinter" FontWeight="SemiBold" />
                        <TextBlock Text="Conexión:" VerticalAlignment="Center" Margin="8,0,6,0" />
                        <ComboBox x:Name="TransportCombo" Width="190" SelectedIndex="0">
                            <ComboBoxItem Content="Bluetooth RFCOMM (recomendado)" Tag="Rfcomm" />
                            <ComboBoxItem Content="Puerto COM" Tag="Serial" />
                            <ComboBoxItem Content="Simulada (pruebas)" Tag="Simulated" />
                        </ComboBox>
                    </StackPanel>
                    <ListView x:Name="DevicesList" MouseDoubleClick="OnUsePrinter">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nombre" Width="170" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Dirección" Width="140" DisplayMemberBinding="{Binding Address}" />
                                <GridViewColumn Header="Modelo" Width="190" DisplayMemberBinding="{Binding Model}" />
                                <GridViewColumn Header="Emparejada" Width="85" DisplayMemberBinding="{Binding PairedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- Plantillas -->
            <TabItem Header="Plantillas" x:Name="TemplatesTab">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Plantilla:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="TemplateCombo" Width="200" />
                        <Button Content="↻" Click="OnTemplateReload" ToolTip="Actualizar la lista de plantillas" />
                        <TextBlock Text="Favoritos:" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox x:Name="FavoriteCombo" Width="150" IsEditable="True" ToolTip="Elige un favorito, o escribe un nombre y pulsa Guardar" />
                        <Button Content="Guardar" Click="OnFavoriteSave" />
                        <Button Content="Borrar" Click="OnFavoriteDelete" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Copias:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="TemplateCopies" Text="1" Width="40" VerticalContentAlignment="Center" />
                        <Button Content="Cargar CSV…" Click="OnTemplateCsv" ToolTip="Una etiqueta por fila; la cabecera lleva los nombres de los campos" />
                        <Button x:Name="TemplateCsvClear" Content="Quitar CSV" Click="OnTemplateCsvClear" Visibility="Collapsed" />
                        <Button Content="Imprimir" Click="OnTemplatePrint" FontWeight="SemiBold" />
                        <TextBlock x:Name="TemplateStatus" VerticalAlignment="Center" Foreground="#57606A" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                            <StackPanel x:Name="TemplateForm" />
                        </ScrollViewer>
                        <Border Grid.Column="1" BorderBrush="#D0D7DE" BorderThickness="1" Background="White" Width="410">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Image x:Name="TemplatePreview" Stretch="None" Margin="12" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Top" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Ajustes -->
            <TabItem Header="Ajustes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" Grid.IsSharedSizeScope="True">
                        <StackPanel.Resources>
                            <Style x:Key="Row" TargetType="Grid">
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="Impresión" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Oscuridad" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="DarknessSlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" TickPlacement="BottomRight" />
                                <TextBlock Text="{Binding Value, ElementName=DarknessSlider}" Margin="8,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Modo de impresión" />
                            <ComboBox x:Name="PrintModeCombo" Grid.Column="1" Width="300" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Automático (texto en modo texto, fotos en modo imagen)" Tag="Auto" />
                                <ComboBoxItem Content="Siempre imagen" Tag="Image" />
                                <ComboBoxItem Content="Siempre texto (más energía)" Tag="Text" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Tramado" />
                            <ComboBox x:Name="DitherCombo" Grid.Column="1" Width="300" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Automático (texto nítido, fotos tramadas)" Tag="Auto" />
                                <ComboBoxItem Content="Atkinson (fotos)" Tag="Atkinson" />
                                <ComboBoxItem Content="Floyd–Steinberg" Tag="FloydSteinberg" />
                                <ComboBoxItem Content="Umbral (solo texto)" Tag="Threshold" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Avance extra al final" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Slider x:Name="FeedSlider" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" TickPlacement="BottomRight" />
                                <TextBlock Text="{Binding Value, ElementName=FeedSlider, StringFormat={}{0} × 6 mm}" Margin="8,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Páginas continuas" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="ContinuousCheck" Content="Unir las páginas en una tira, separadas por" VerticalAlignment="Center" />
                                <TextBox x:Name="GapBox" Width="40" Margin="6,0" />
                                <TextBlock Text="mm" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <!-- SETTINGS:PRINT -->

                        <TextBlock Text="Batería" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Unidad del valor" />
                            <ComboBox x:Name="BatteryUnitCombo" Grid.Column="1" Width="300" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Desconocida (mostrar valor en bruto)" Tag="Unknown" />
                                <ComboBoxItem Content="Porcentaje" Tag="Percent" />
                                <ComboBoxItem Content="Décimas de voltio" Tag="Decivolts" />
                            </ComboBox>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Avisar por debajo de" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="LowBatteryBox" Width="50" />
                                <TextBlock Text="% (solo con una unidad conocida)" Margin="8,0" VerticalAlignment="Center" Foreground="#57606A" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Conexión y red" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Mantener activa" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="KeepAliveCheck" Content="Mantener conectada (keep-alive), latido cada" VerticalAlignment="Center" />
                                <TextBox x:Name="KeepAliveIntervalBox" Width="45" Margin="6,0" />
                                <TextBlock Text="s · el móvil no podrá usarla mientras tanto" VerticalAlignment="Center" Foreground="#57606A" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Desconectar tras" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="IdleBox" Width="60" IsEnabled="{Binding IsChecked, ElementName=KeepAliveCheck, Converter={StaticResource Not}}" />
                                <TextBlock Text="segundos sin uso (libera la impresora para el móvil)" Margin="8,0" VerticalAlignment="Center" Foreground="#57606A" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Nombre en Windows" />
                            <TextBox x:Name="NameBox" Grid.Column="1" Width="260" HorizontalAlignment="Left" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Imprimir desde" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <RadioButton x:Name="LocalRadio" Content="Solo este PC" GroupName="Net" Margin="0,2" />
                                <RadioButton x:Name="LanRadio" Content="Toda la red local (otros PCs, iPhone y Android la encuentran solos)" GroupName="Net" Margin="0,2" />
                                <TextBlock Text="En modo red local solo se comparte la impresión; este panel nunca es accesible desde la red."
                                           Foreground="#57606A" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Puerto IPP" />
                            <TextBox x:Name="PortBox" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
                        </Grid>
                        <!-- SETTINGS:NETWORK -->

                        <TextBlock Text="Actualizaciones" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Comprobar" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <CheckBox x:Name="AutoUpdateCheck" Content="Comprobar actualizaciones automáticamente (cada 24 h)" VerticalAlignment="Center"
                                          Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
                                <Button Content="Buscar ahora" Click="OnCheckUpdates" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Impresión rápida" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Atajo de nota rápida" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="HotkeyBox" Width="140" />
                                <Button Content="Aplicar" Click="OnApplyHotkey" Margin="8,0,0,0" />
                                <TextBlock x:Name="HotkeyStatus" VerticalAlignment="Center" Foreground="#57606A"
                                           Text="Ej.: Ctrl+Alt+P. También puedes soltar archivos en esta ventana o usar «Enviar a &gt; MiniPrinter»." TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="API de automatización" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Estado" />
                            <CheckBox x:Name="AutomationCheck" Grid.Column="1" VerticalAlignment="Center"
                                      Content="Permitir imprimir desde scripts, Home Assistant o n8n (se aplica al guardar)" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Token" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="AutomationTokenBox" Width="300" IsReadOnly="True" FontFamily="Consolas" />
                                <Button Content="Copiar" Click="OnCopyToken" Margin="8,0,0,0" />
                                <Button Content="Regenerar" Click="OnRegenerateToken" />
                            </StackPanel>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="L" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Direcciones" VerticalAlignment="Top" />
                            <TextBlock x:Name="AutomationUrlsText" Grid.Column="1" TextWrapping="Wrap" Foreground="#57606A"
                                       Text="Activa la API y guarda para ver las direcciones." />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Guardar" Click="OnSaveSettings" FontWeight="SemiBold" />
                            <Button Content="Recargar" Click="OnLoadSettings" />
                            <TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" Foreground="#57606A" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
