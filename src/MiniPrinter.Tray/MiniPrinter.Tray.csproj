<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <ApplicationIcon>..\..\assets\miniprinter.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MiniPrinter.Tray</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for NotifyIcon; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MiniPrinter.Control\MiniPrinter.Control.csproj" />
    <ProjectReference Include="..\MiniPrinter.Protocol\MiniPrinter.Protocol.csproj" />
    <ProjectReference Include="..\MiniPrinter.Updates\MiniPrinter.Updates.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\miniprinter.ico" Link="miniprinter.ico" />
  </ItemGroup>
</Project>
