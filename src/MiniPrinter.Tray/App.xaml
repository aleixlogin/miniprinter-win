<Application x:Class="MiniPrinter.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active theme: ThemeService replaces it when Windows or the user change the theme. -->
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Base font size of every window (Settings, Appearance, Text size replaces it). -->
            <sys:Double x:Key="Ui.FontSize">13</sys:Double>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                <Setter Property="Margin" Value="0,4,12,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Value" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
