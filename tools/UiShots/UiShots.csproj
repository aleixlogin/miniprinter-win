<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MiniPrinter.Tray\MiniPrinter.Tray.csproj" />
    <ProjectReference Include="..\..\src\MiniPrinter.Gui\MiniPrinter.Gui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The panel asks for pack://application:,,,/miniprinter.ico: here the application is this tool. -->
    <Resource Include="..\..\assets\miniprinter.ico" Link="miniprinter.ico" />
  </ItemGroup>
</Project>
