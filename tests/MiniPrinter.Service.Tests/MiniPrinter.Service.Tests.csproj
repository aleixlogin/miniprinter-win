<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Blocking on .Result in a test can hang or flake: make the analyzer an error. -->
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1031</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MiniPrinter.Service\MiniPrinter.Service.csproj" />
    <ProjectReference Include="..\..\src\MiniPrinter.Control\MiniPrinter.Control.csproj" />
    <ProjectReference Include="..\..\src\MiniPrinter.Transport\MiniPrinter.Transport.csproj" />
    <ProjectReference Include="..\..\src\MiniPrinter.Protocol\MiniPrinter.Protocol.csproj" />
    <ProjectReference Include="..\..\src\MiniPrinter.Ipp\MiniPrinter.Ipp.csproj" />
    <ProjectReference Include="..\..\src\MiniPrinter.Imaging\MiniPrinter.Imaging.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MiniPrinter.Imaging.Tests\MiniPdf.cs" Link="MiniPdf.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every test starts its own service and waits for its port: with several classes at once (async waits do not hold the few threads of the runner) a small CI machine was starved for minutes. One class at a time. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
